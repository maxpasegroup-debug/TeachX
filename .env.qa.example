# Copy to .env.qa.local and replace placeholders. Never commit .env.qa.local.
QA_DATABASE_URL="postgresql://<qa-user>:<qa-password>@<qa-host>:5432/teachx_qa"
QA_DATABASE_CONFIRM="TEACHX_QA_ONLY"
QA_DATABASE_INITIALIZE="true"
QA_ALLOW_DATABASE_WRITES="true"
QA_REDIS_URL="redis://<qa-host>:6379"

# Use QA-only values. Never reuse production authentication or provider secrets.
AUTH_SECRET="<qa-only-secret-at-least-32-characters>"

# Optional comparison values strengthen the guard when available.
PRODUCTION_DATABASE_URL=""
PRODUCTION_REDIS_URL=""
