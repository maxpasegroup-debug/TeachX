  endsAt          DateTime?
  publishedAt     DateTime?
  closedAt        DateTime?
  aiBlueprint     Json?
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
  results         ExamResult[]
  leaderboards    Leaderboard[]
  analytics       PerformanceAnalytics[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([institutionId, status])
}

model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order         Int      @default(1)
  marks         Decimal  @default(1)
  negativeMarks Decimal  @default(0)

  @@unique([examId, questionId])
}

model ExamAttempt {
  id               String            @id @default(cuid())
  examId           String
  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  student          User              @relation("ExamAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status           ExamAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int               @default(0)
  currentQuestion  Int               @default(1)
  answers          ExamAnswer[]
  result           ExamResult?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([examId, studentId])
}

model ExamAnswer {
  id               String           @id @default(cuid())
  attemptId        String
  attempt          ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer           String?
  status           ExamAnswerStatus @default(NOT_VISITED)
  isCorrect        Boolean?
  marksAwarded     Decimal          @default(0)
  timeSpentSeconds Int              @default(0)
  updatedAt        DateTime         @updatedAt

  @@unique([attemptId, questionId])
}

model ExamResult {
  id         String      @id @default(cuid())
  examId     String
  exam       Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  attemptId  String      @unique
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId  String
  score      Decimal     @default(0)
  correct    Int         @default(0)
  wrong      Int         @default(0)
  skipped    Int         @default(0)
  percentage Decimal     @default(0)
  passed     Boolean     @default(false)
  createdAt  DateTime    @default(now())
}

model Leaderboard {
  id               String   @id @default(cuid())
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  rank             Int
  scope            String
  score            Decimal  @default(0)
  accuracy         Decimal  @default(0)
  timeTakenSeconds Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([examId, studentId, scope])
}

model PerformanceAnalytics {
  id              String   @id @default(cuid())
  examId          String?
  exam            Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
