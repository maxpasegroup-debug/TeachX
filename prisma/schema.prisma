  subjectId       String?
  chapterId       String?
  topicId         String?
  strongAreas     Json?
  weakAreas       Json?
  accuracy        Decimal  @default(0)
  attemptCount    Int      @default(0)
  recommendations Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId, examId])
}

model FeeHead {
