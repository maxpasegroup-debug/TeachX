  sizeBytes      Int
  checksumSha256 String
  etag           String?
  signedAt       DateTime      @default(now())
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([objectId, partNumber])
  @@index([objectId, completedAt])
}

model StorageTransferEvent {
  id        String              @id @default(cuid())
  objectId  String
  object    StorageObject       @relation(fields: [objectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?               @relation("StorageTransferActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      StorageTransferKind
  requestId String?
  bytes     BigInt?
  detail    Json?
  createdAt DateTime            @default(now())

  @@index([objectId, createdAt])
  @@index([actorId, createdAt])
  @@index([kind, createdAt])
}

model TransactionalEmail {
  id                String                    @id @default(cuid())
  institutionId     String?
  institution       Institution?              @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind              String
  provider          String                    @default("resend")
  providerMessageId String?                   @unique
  idempotencyKey    String                    @unique
  recipientHash     String
  recipientDomain   String
  status            TransactionalEmailStatus  @default(QUEUED)
  attemptCount      Int                       @default(0)
  lastErrorCode     String?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  metadata          Json?
  events            TransactionalEmailEvent[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([institutionId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TransactionalEmailEvent {
  id                String              @id @default(cuid())
  providerEventId   String              @unique
  providerMessageId String
  type              String
  payloadHash       String
  emailId           String?
  email             TransactionalEmail? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  providerCreatedAt DateTime?
  receivedAt        DateTime            @default(now())

  @@index([providerMessageId, receivedAt])
  @@index([emailId, receivedAt])
}
