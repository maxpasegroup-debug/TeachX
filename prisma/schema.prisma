model Institution {
  id                    String                 @id @default(cuid())
  name                  String
  logoUrl               String?
  primaryColor          String                 @default("#111827")
  secondaryColor        String                 @default("#64748b")
  address               String?
  phone                 String?
  email                 String?
  website               String?
  timezone              String                 @default("Asia/Kolkata")
  academicYear          String?
  currency              String                 @default("INR")
  users                 User[]
  settings              Setting[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  branches              Branch[]
  academicYears         AcademicYear[]
  departments           Department[]
  courses               Course[]
  plannerEvents         PlannerEvent[]
  timeSlots             TimeSlot[]
  rooms                 Room[]
  classrooms            Classroom[]
  leadSources           CampaignSource[]
  campaigns             Campaign[]
  leads                 Lead[]
  applications          Application[]
  admissions            Admission[]
  partners              Partner[]
  questionImports       QuestionImport[]
  exams                 Exam[]
  feeHeads              FeeHead[]
  feePlans              FeePlan[]
  studentFees           StudentFee[]
  payments              Payment[]
  invoices              Invoice[]
  receipts              Receipt[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  payrolls              Payroll[]
  visitors              Visitor[]
  appointments          Appointment[]
  contentFolders        ContentFolder[]
  contentItems          ContentItem[]
  activities            Activity[]
  communications        Communication[]
  directConversations   DirectConversation[]
  communities           Community[]
  genericDiscussions    GenericDiscussion[]
  notificationTemplates NotificationTemplate[]
  activityEvents        ActivityEvent[]
  supportTickets        SupportTicket[]
  supportReplies        SupportReply[]
  featureFlags          FeatureFlag[]
  platformMetrics       PlatformMetric[]
  aiConversations       AIConversation[]
  aiUsages              AIUsage[]
  promptTemplates       PromptTemplate[]
  automationRules       AutomationRule[]
  subscriptionPlans     SubscriptionPlan[]
  userSubscriptions     UserSubscription[]
  wallets               Wallet[]
  walletTransactions    WalletTransaction[]
  commerceOrders        CommerceOrder[]
  coupons               Coupon[]
  referrals             Referral[]
  commerceInvoices      CommerceInvoice[]
  commerceCreditNotes   CommerceCreditNote[]
  commercePaymentEvents CommercePaymentEvent[]
  transactionalEmails   TransactionalEmail[]
  storageObjects        StorageObject[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model User {
  id                             String                          @id @default(cuid())
  institutionId                  String?
  institution                    Institution?                    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  email                          String                          @unique
  name                           String
  userType                       UserType?
  passwordHash                   String?
  phoneE164                      String?                         @unique
  phoneVerifiedAt                DateTime?
  pinHash                        String?
  pinFailedAttempts              Int                             @default(0)
  pinLockedUntil                 DateTime?
  pinChangedAt                   DateTime?
  authSessionVersion             Int                             @default(0)
  status                         UserStatus                      @default(ACTIVE)
  emailVerifiedAt                DateTime?
  lastLoginAt                    DateTime?
  rememberToken                  String?
  roles                          UserRole[]
  profile                        Profile?
  teacherProfile                 TeacherProfile?
  studentProfile                 StudentProfile?
  notifications                  Notification[]
  plannerItemsCreated            PlannerEvent[]                  @relation("PlannerEventCreator")
  auditLogs                      AuditLog[]                      @relation("ActorAuditLogs")
  accounts                       Account[]
  sessions                       Session[]
  resetTokens                    PasswordResetToken[]
  phoneOtpChallenges             PhoneOtpChallenge[]
  transactionalEmails            TransactionalEmail[]
  storageObjects                 StorageObject[]                 @relation("StorageObjectOwner")
  storageTransferEvents          StorageTransferEvent[]          @relation("StorageTransferActor")
  facultyBatches                 BatchFaculty[]
  studentBatches                 BatchStudent[]
  timetableEntries               TimetableEntry[]                @relation("TimetableFaculty")
  scheduleOverrides              DailyScheduleOverride[]         @relation("OverrideFaculty")
  classroomAnnouncements         ClassroomAnnouncement[]         @relation("AnnouncementAuthor")
  materials                      StudyMaterial[]                 @relation("MaterialUploader")
  assignments                    Assignment[]                    @relation("AssignmentCreator")
  assignmentSubmissions          AssignmentSubmission[]          @relation("SubmissionStudent")
  reviewedAssignmentSubmissions  AssignmentSubmission[]          @relation("SubmissionReviewer")
  reviewedAssignmentRevisions    AssignmentSubmissionRevision[]  @relation("RevisionReviewer")
  assignmentDoubts               AssignmentDoubt[]               @relation("AssignmentDoubtStudent")
  assignmentDoubtMessages        AssignmentDoubtMessage[]        @relation("AssignmentDoubtMessageAuthor")
  marketplaceEntitlements        MarketplaceEntitlement[]
  marketplaceCart                MarketplaceCart?
  marketplaceReviews             MarketplaceBuyerReview[]        @relation("MarketplaceReviewBuyer")
  marketplaceReviewVotes         MarketplaceReviewHelpfulVote[]
  marketplaceReviewReports       MarketplaceReviewReport[]
  marketplaceWishlistCollections MarketplaceWishlistCollection[]
  marketplaceWishlistItems       MarketplaceWishlistItem[]
  attendanceRecords              AttendanceRecord[]              @relation("AttendanceStudent")
  recordings                     Recording[]                     @relation("RecordingUploader")
  liveSessions                   LiveSession[]                   @relation("LiveSessionFaculty")
  learningProgress               LearningProgress[]              @relation("LearningProgressStudent")
  videoProgress                  VideoProgress[]                 @relation("VideoProgressStudent")
  bookmarks                      Bookmark[]                      @relation("BookmarkStudent")
  studentNotes                   StudentNote[]                   @relation("StudentNoteOwner")
  discussionThreads              DiscussionThread[]              @relation("DiscussionThreadAuthor")
  discussionReplies              DiscussionReply[]               @relation("DiscussionReplyAuthor")
  assignedLeads                  Lead[]                          @relation("AssignedExecutive")
  ownedLeadTasks                 LeadTask[]                      @relation("LeadTaskOwner")
  leadActivities                 LeadActivity[]                  @relation("LeadActivityActor")
  guestLeads                     Lead[]                          @relation("LeadGuestUser")
  partnerProfile                 Partner?
  admissionsAsStudent            Admission[]                     @relation("AdmissionStudent")
  authoredQuestions              Question[]                      @relation("QuestionAuthor")
  questionImports                QuestionImport[]
  createdExams                   Exam[]                          @relation("ExamCreator")
  examAttempts                   ExamAttempt[]                   @relation("ExamAttemptStudent")
  studentFees                    StudentFee[]                    @relation("StudentFeeStudent")
  payments                       Payment[]                       @relation("PaymentStudent")
  invoices                       Invoice[]                       @relation("InvoiceStudent")
  createdContent                 ContentItem[]                   @relation("ContentCreator")
  contentVersions                ContentVersion[]                @relation("ContentVersionUpdater")
  contentReviews                 ContentReview[]                 @relation("ContentReviewer")
  contentApprovals               ContentApproval[]               @relation("ContentApprover")
  contentDownloads               DownloadHistory[]               @relation("ContentDownloadUser")
  contentWatches                 WatchHistory[]                  @relation("ContentWatchUser")
  workspacePreferences           WorkspacePreference[]
  userPreferences                UserPreference[]
  savedSearches                  SavedSearch[]
  dashboardWidgets               DashboardWidget[]
  recentItems                    RecentItem[]
  favoriteItems                  FavoriteItem[]
  notificationPreferences        NotificationPreference[]
  activities                     Activity[]                      @relation("ActivityActor")
  parentLinks                    ParentChildRelation[]           @relation("ParentRelation")
  childLinks                     ParentChildRelation[]           @relation("ChildRelation")
  communicationsCreated          Communication[]                 @relation("CommunicationCreator")
  communicationRecipients        CommunicationRecipient[]
  communicationLogs              CommunicationLog[]
  directConversationsCreated     DirectConversation[]            @relation("DirectConversationCreator")
  directConversationParticipants DirectConversationParticipant[]
  sentDirectMessages             DirectMessage[]                 @relation("DirectMessageSender")
  communitiesCreated             Community[]                     @relation("CommunityCreator")
  communityMemberships           CommunityMember[]
  genericDiscussions             GenericDiscussion[]             @relation("GenericDiscussionAuthor")
  genericDiscussionReplies       GenericDiscussionReply[]        @relation("GenericDiscussionReplyAuthor")
  notificationTemplatesCreated   NotificationTemplate[]          @relation("NotificationTemplateCreator")
  activityEvents                 ActivityEvent[]                 @relation("ActivityEventActor")
  supportTicketsCreated          SupportTicket[]                 @relation("SupportTicketRequester")
  supportTicketsAssigned         SupportTicket[]                 @relation("SupportTicketAssignee")
  supportReplies                 SupportReply[]                  @relation("SupportReplyAuthor")
  aiConversations                AIConversation[]
  aiUsages                       AIUsage[]
  subscriptions                  UserSubscription[]
  wallets                        Wallet[]
  walletTransactions             WalletTransaction[]
  commerceOrders                 CommerceOrder[]                 @relation("CommerceOrderBuyer")
  soldOrderItems                 CommerceOrderItem[]             @relation("CommerceOrderItemSeller")
  commerceInvoices               CommerceInvoice[]               @relation("CommerceInvoiceBuyer")
  referralsMade                  Referral[]                      @relation("ReferralReferrer")
  referralsUsed                  Referral[]                      @relation("ReferralReferred")
  automationExecutions           AutomationExecution[]
  staffProfile                   StaffProfile?
  leaveApplications              LeaveApplication[]              @relation("LeaveApplicant")
  approvedLeaves                 LeaveApplication[]              @relation("LeaveApprover")
  privacyConsents                PrivacyConsent[]
  privacyRequests                PrivacyRequest[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  @@index([userType])
}

model Branch {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String
  address       String?
  contact       String?
  status        RecordStatus @default(ACTIVE)
  courses       Course[]
  batches       Batch[]
  rooms         Room[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model AcademicYear {
  id               String             @id @default(cuid())
  institutionId    String
  institution      Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name             String
  startDate        DateTime
  endDate          DateTime
  status           AcademicYearStatus @default(PLANNED)
  isCurrent        Boolean            @default(false)
  terms            AcademicTerm[]
  courses          Course[]
  batches          Batch[]
  plannerEvents    PlannerEvent[]
  timetableEntries TimetableEntry[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId, isCurrent])
}

model AcademicTerm {
  id             String           @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  type           AcademicTermType @default(SEMESTER)
  startDate      DateTime
  endDate        DateTime
  order          Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([academicYearId, name])
}

model Department {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  status        RecordStatus @default(ACTIVE)
  courses       Course[]
  subjects      Subject[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, name])
}

model Course {
  id               String              @id @default(cuid())
  institutionId    String
  institution      Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicYearId   String?
  academicYear     AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name             String
  description      String?
  code             String
  duration         String?
  category         String?
  status           RecordStatus        @default(ACTIVE)
  thumbnailUrl     String?
  learningModes    LearningMode[]
  subjects         Subject[]
  batches          Batch[]
  timetableEntries TimetableEntry[]
  classrooms       Classroom[]
  learningProgress LearningProgress[]
  leads            Lead[]
  applications     Application[]
  admissions       Admission[]
  commissionRules  PartnerCommission[]
  chapters         Chapter[]
  topics           Topic[]
  questions        Question[]
  exams            Exam[]
  feePlans         FeePlan[]
  studentFees      StudentFee[]
  contentFolders   ContentFolder[]
  contentItems     ContentItem[]
  communications   Communication[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Subject {
  id                String                  @id @default(cuid())
  courseId          String
  course            Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
